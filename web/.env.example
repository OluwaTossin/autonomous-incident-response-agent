# Server-only. Do not prefix secrets or internal endpoints with NEXT_PUBLIC_.
AIRA_WEB_APP_ORIGIN=http://localhost:3001
AIRA_WEB_API_BASE_URL=http://127.0.0.1:8000
AIRA_WEB_DATABASE_URL=postgresql://aira_app:change-me@127.0.0.1:55432/aira_hosted
AIRA_WEB_OIDC_ISSUER=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_example
AIRA_WEB_OIDC_DOMAIN=https://example.auth.eu-west-1.amazoncognito.com
AIRA_WEB_OIDC_CLIENT_ID=replace-me
# AIRA_WEB_OIDC_CLIENT_SECRET=replace-me
AIRA_WEB_OIDC_SCOPES=openid email profile
AIRA_WEB_SESSION_ENCRYPTION_KEY=base64-encoded-32-byte-key
AIRA_WEB_SESSION_COOKIE=aira_hosted_session
AIRA_WEB_SESSION_INACTIVITY_SECONDS=3600
AIRA_WEB_SESSION_ABSOLUTE_SECONDS=43200
AIRA_WEB_LOGIN_TRANSACTION_SECONDS=600
AIRA_WEB_API_TIMEOUT_MS=10000
# AIRA_WEB_OIDC_LOGOUT_REDIRECT=http://localhost:3001/login
