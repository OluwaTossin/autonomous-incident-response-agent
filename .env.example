# Copy this file to `.env` in the same directory and fill in values.
# Never commit `.env`. Never put real keys in `.env.example` (this file is for Git).

# Optional: YAML file with non-secret tuning (RAG_TOP_K, LLM_MODEL, rate limits, …).
# Same keys as env vars; `.env` / process environment wins over YAML for each key.
# CONFIG_YAML=config.yaml

# V3 hosted runtime observability. Identifiers appear in protected logs/traces only,
# never as metric dimensions. Empty OTLP keeps local development collector-free.
# AIRA_BUILD_SHA=unknown
# AIRA_METRIC_NAMESPACE=AIRA/Hosted
# AIRA_OTEL_EXPORTER_OTLP_ENDPOINT=
# AIRA_TRACE_SAMPLE_RATIO=0.05

# --- LLM / embeddings (RAG build-index and future agent) ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional: OpenAI-compatible API base (e.g. OpenRouter for chat; embeddings often still use OpenAI)
# OPENAI_API_BASE=https://openrouter.ai/api/v1
EMBEDDING_MODEL=text-embedding-3-small
# RAG index: unset → workspaces/<WORKSPACE_ID>/index. For legacy layout at repo root:
# RAG_INDEX_DIR=.rag_index
# Corpus: unset → workspace data/ if it contains files, else repo data/. Override:
# RAG_CORPUS_ROOT=data
# When 1, corpus root is always workspaces/<WORKSPACE_ID>/data/ (product-build-index sets this).
# RAG_WORKSPACE_ONLY=0
# WORKSPACE_ID=default
# WORKSPACES_ROOT=workspaces
# AIRA_DATA_MODE=demo   # demo | user — demo uses sample_data/default_demo when workspace data/ is empty

# Phase 4 triage (chat; OpenAI-compatible)
LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.2
# RAG_TOP_K=8

# Phase 5 API (`uv run serve-api`)
# API_HOST=127.0.0.1
# API_PORT=8000

# V3 hosted PostgreSQL (optional; not used by Version 2 commands or default Compose).
# Runtime and migration credentials must be different. The runtime role is a non-owner
# subject to RLS; only Alembic uses the schema-owner URL.
# AIRA_DATABASE_URL=postgresql+psycopg://aira_app:change-me@127.0.0.1:55432/aira_hosted?sslmode=require
# AIRA_DATABASE_MIGRATION_URL=postgresql+psycopg://aira_migrator:change-me@127.0.0.1:55432/aira_hosted
# Local docker-compose.hosted-db.yml bootstrap values:
# AIRA_DB_MIGRATION_PASSWORD=change-me
# AIRA_DB_RUNTIME_PASSWORD=change-me-too
# AIRA_POSTGRES_PORT=55432

# V3.11 hosted SQS transport and bounded worker runtime. Credentials come from
# the normal AWS workload/profile environment and are never stored here.
# AIRA_SQS_QUEUE_URL=
# AIRA_ALERT_QUEUE_URL=
# AIRA_AWS_REGION=us-east-1
# AIRA_SQS_ENDPOINT_URL=              # tests/emulators only
# AIRA_SQS_LONG_POLL_SECONDS=20
# AIRA_SQS_RECEIVE_BATCH_SIZE=10
# AIRA_SQS_VISIBILITY_TIMEOUT_SECONDS=300
# AIRA_WORKER_HEARTBEAT_SECONDS=60
# AIRA_WORKER_JOB_LEASE_SECONDS=900
# AIRA_WORKER_CONCURRENCY=4
# AIRA_DISPATCHER_BATCH_SIZE=10
# AIRA_DISPATCHER_LEASE_SECONDS=30
# AIRA_SQS_CONNECT_TIMEOUT_SECONDS=3
# AIRA_SQS_READ_TIMEOUT_SECONDS=25
# AIRA_SQS_MAX_ATTEMPTS=3

# V3.16 customer AWS integration verification. The principal is the deployed AIRA
# workload IAM role that customer roles trust; never invent a production value.
# Stable broker ARN shown in customer trust policies; task roles assume it first.
# AIRA_AWS_TRUSTED_PRINCIPAL_ARN=arn:aws:iam::111122223333:role/aira/aira-prod-customer-read
# AIRA_AWS_SOURCE_ROLE_ARN=arn:aws:iam::111122223333:role/aira/aira-prod-customer-read
# AIRA_PUBLIC_ORIGIN=https://app.example.com
# AIRA_DOCUMENT_BUCKET=
# AIRA_KNOWLEDGE_BUCKET=
# AIRA_KMS_KEY_ARN=
# AIRA_WORKLOAD_SUBJECT=arn:aws:iam::111122223333:role/aira-prod-worker
# JSON secret: [{organization_id,workspace_id,integration_id,aws_account_id,regions:[...]}]
# AIRA_WORKER_SCOPE_GRANTS=
# AIRA_STS_ENDPOINT_URL=             # tests/emulators only
# AIRA_AWS_VERIFICATION_CONNECT_TIMEOUT_SECONDS=3
# AIRA_AWS_VERIFICATION_READ_TIMEOUT_SECONDS=8
# AIRA_AWS_VERIFICATION_MAX_ATTEMPTS=3

# V3.4 hosted human identity (optional; no live Cognito pool is required for local tests).
# For Cognito, issuer is https://cognito-idp.<region>.amazonaws.com/<user-pool-id>.
# AIRA_OIDC_ISSUER=
# AIRA_OIDC_CLIENT_ID=
# AIRA_OIDC_TOKEN_USE=access
# AIRA_OIDC_JWKS_URL=                 # defaults to <issuer>/.well-known/jwks.json
# AIRA_OIDC_ALGORITHMS=RS256
# AIRA_OIDC_LEEWAY_SECONDS=30
# AIRA_OIDC_JWKS_CACHE_SECONDS=300
# AIRA_OIDC_HTTP_TIMEOUT_SECONDS=3

# V3.13 hosted Next.js server (web/). These values are server-only; do not rename
# credentials or internal endpoints to NEXT_PUBLIC_*.
# AIRA_WEB_APP_ORIGIN=http://localhost:3001
# AIRA_WEB_API_BASE_URL=http://127.0.0.1:8000
# Node pg uses a standard PostgreSQL URL (without SQLAlchemy's +psycopg suffix).
# AIRA_WEB_DATABASE_URL=postgresql://aira_app:change-me@127.0.0.1:55432/aira_hosted
# AIRA_WEB_OIDC_ISSUER=https://cognito-idp.eu-west-1.amazonaws.com/eu-west-1_example
# AIRA_WEB_OIDC_DOMAIN=https://example.auth.eu-west-1.amazoncognito.com
# AIRA_WEB_OIDC_CLIENT_ID=
# AIRA_WEB_OIDC_CLIENT_SECRET=       # optional confidential app client; server-only
# AIRA_WEB_OIDC_SCOPES=openid email profile
# AIRA_WEB_SESSION_ENCRYPTION_KEY=   # base64-encoded 32-byte key; server-only
# AIRA_WEB_SESSION_COOKIE=aira_hosted_session
# AIRA_WEB_SESSION_INACTIVITY_SECONDS=3600
# AIRA_WEB_SESSION_ABSOLUTE_SECONDS=43200
# AIRA_WEB_LOGIN_TRANSACTION_SECONDS=600
# AIRA_WEB_API_TIMEOUT_MS=10000
# AIRA_WEB_OIDC_LOGOUT_REDIRECT=     # optional Cognito logout redirect

# Optional: shared secret for POST /ingest-incident and POST /triage. Send header: x-api-key: <value>
# Unset = no check (local dev). Set in prod / demo (and in ECS task env or SSM) to filter abuse.
# API_KEY=demo-key-123
# Version 2 admin routes (`/admin/upload`, `/admin/files`, `/admin/reindex`, `/admin/index-status`,
# `PATCH /admin/operator-settings`). When unset, /admin/* returns 503. Use header x-admin-api-key (must differ from API_KEY).
# ADMIN_API_KEY=
# ADMIN_UPLOAD_MAX_BYTES=5242880
# API_RATE_LIMIT_ADMIN_READ=120/minute
# API_RATE_LIMIT_ADMIN_UPLOAD=20/minute
# API_RATE_LIMIT_ADMIN_REINDEX=2/minute
# Browser / Next.js: NEXT_PUBLIC_TRIAGE_API_KEY (same value; visible in static bundle — fine for demos).
# Next.js only: set to 1 if a same-origin reverse proxy injects x-admin-api-key (browser never sends it).
# NEXT_PUBLIC_ADMIN_PROXY_INJECTS_HEADERS=0
# Rate limits (slowapi): per x-api-key when present, else per client IP. Disable for tests: API_RATE_LIMIT_DISABLED=1
# API_RATE_LIMIT_TRIAGE=10/minute
# API_RATE_LIMIT_INGEST=30/minute

# Phase 12 — Next.js triage console (browser → API). Comma-separated origins; unset defaults to localhost:3000 + 127.0.0.1:3000.
# On ECS, set via Terraform cors_origins (injected as CORS_ORIGINS on the task).
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Phase 7 Gradio UI at /ui (install: uv sync --extra ui). Set 0 to disable mount.
# ENABLE_GRADIO_UI=1

# Phase 9 / V2.5 — product Compose: API + Next.js by default; n8n via profile `automation` (see docker-compose.yml).
# COMPOSE_API_PORT=18080
# Next.js static UI (nginx) published on host (default 3000).
# COMPOSE_UI_PORT=3000
# Optional: start n8n in one command — COMPOSE_PROFILES=automation docker compose up -d --build
# To use host port 8000 for the API instead: COMPOSE_API_PORT=8000

# E2E script scripts/e2e_stack_check.sh (optional)
# API_BASE=http://127.0.0.1:18080
# STRICT_RAG_EVIDENCE=1
# SKIP_N8N=1
# SKIP_TRIAGE=1
# Phase 6 — n8n only: docker compose -f docker-compose.n8n.yml
# Docker Compose reads THIS repo-root .env for ${VAR} substitution (do not commit real URLs).
# After editing .env, recreate n8n: docker compose -f docker-compose.n8n.yml up -d --force-recreate
SLACK_WEBHOOK_URL=
# TRIAGE_API_BASE=http://host.docker.internal:8000
# N8N_WORKFLOW_LOG_DISABLE=1
# N8N_WORKFLOW_LOG_JSONL=/custom/n8n_events.jsonl
# N8N_TRIAGE_FEEDBACK_DISABLE=1
# N8N_TRIAGE_FEEDBACK_JSONL=/custom/triage_feedback.jsonl

# Append each POST /triage request+response to JSONL (default: data/logs/triage_outputs.jsonl)
# TRIAGE_AUDIT_DISABLE=1
# TRIAGE_AUDIT_JSONL=/path/to/custom.jsonl
# Cap stored RAG text size (characters); 0 = no truncation
# TRIAGE_AUDIT_MAX_RAG_CHARS=200000

# Phase 13 — suppress one-line JSON triage metrics on stdout + aira.triage logger (CloudWatch metric filters read stdout on ECS)
# TRIAGE_METRICS_LOG_DISABLE=1

# --- AWS (Terraform CLI / aws CLI — not auto-loaded by Terraform) ---
# Terraform does not read this file. Export these (or use AWS_PROFILE) before
# `terraform` in infra/terraform/envs/{dev,prod}. Name must be AWS_ACCESS_KEY_ID (not WS_).
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Phase 11: same credentials work for `aws` + `./scripts/aws/push_api_to_ecr.sh dev` (after terraform apply).

# --- Optional integrations ---
VECTOR_DB_API_KEY=
N8N_BASIC_AUTH_USER=
N8N_BASIC_AUTH_PASSWORD=

# ANTHROPIC_API_KEY=
