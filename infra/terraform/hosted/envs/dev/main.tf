module "platform" {
  source                              = "../../modules/platform"
  environment                         = "dev"
  aws_region                          = var.aws_region
  aws_account_id                      = var.aws_account_id
  availability_zones                  = var.availability_zones
  vpc_cidr                            = var.vpc_cidr
  route53_zone_id                     = var.route53_zone_id
  web_hostname                        = var.web_hostname
  api_hostname                        = var.api_hostname
  nat_gateway_mode                    = "single"
  enable_interface_endpoints          = false
  enable_deletion_protection          = false
  log_retention_days                  = 14
  force_destroy_nonproduction         = true
  enable_runtime_services             = var.enable_runtime_services
  build_sha                           = var.build_sha
  otel_exporter_otlp_endpoint         = var.otel_exporter_otlp_endpoint
  alarm_action_arns                   = var.alarm_action_arns
  quota_defaults                      = var.quota_defaults
  api_image_digest                    = var.api_image_digest
  worker_image_digest                 = var.worker_image_digest
  web_image_digest                    = var.web_image_digest
  api_cpu                             = 512
  api_memory                          = 1024
  api_desired_count                   = 1
  api_max_count                       = 2
  worker_cpu                          = 1024
  worker_memory                       = 2048
  worker_desired_count                = 1
  worker_max_count                    = 2
  dispatcher_desired_count            = 1
  web_cpu                             = 512
  web_memory                          = 1024
  web_desired_count                   = 1
  web_max_count                       = 2
  database_instance_class             = "db.t4g.micro"
  database_allocated_storage          = 20
  database_max_allocated_storage      = 100
  database_multi_az                   = false
  database_backup_retention_days      = 7
  database_monitoring_interval        = 0
  database_name                       = "aira"
  database_migration_username         = "aira_migrator"
  cognito_domain_prefix               = var.cognito_domain_prefix
  cognito_mfa_configuration           = "OPTIONAL"
  cognito_callback_urls               = ["https://${var.web_hostname}/auth/callback"]
  cognito_logout_urls                 = ["https://${var.web_hostname}/login"]
  allowed_eventbridge_source_accounts = var.allowed_eventbridge_source_accounts
  tags                                = var.tags
}
