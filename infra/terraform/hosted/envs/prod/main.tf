module "platform" {
  source                              = "../../modules/platform"
  environment                         = "prod"
  aws_region                          = var.aws_region
  aws_account_id                      = var.aws_account_id
  availability_zones                  = var.availability_zones
  vpc_cidr                            = var.vpc_cidr
  route53_zone_id                     = var.route53_zone_id
  web_hostname                        = var.web_hostname
  api_hostname                        = var.api_hostname
  nat_gateway_mode                    = "per_az"
  enable_interface_endpoints          = true
  enable_deletion_protection          = true
  log_retention_days                  = 90
  force_destroy_nonproduction         = false
  enable_runtime_services             = var.enable_runtime_services
  api_image_digest                    = var.api_image_digest
  worker_image_digest                 = var.worker_image_digest
  web_image_digest                    = var.web_image_digest
  api_cpu                             = 1024
  api_memory                          = 2048
  api_desired_count                   = 2
  api_max_count                       = 8
  worker_cpu                          = 2048
  worker_memory                       = 4096
  worker_desired_count                = 2
  worker_max_count                    = 12
  dispatcher_desired_count            = 1
  web_cpu                             = 1024
  web_memory                          = 2048
  web_desired_count                   = 2
  web_max_count                       = 6
  database_instance_class             = "db.r7g.large"
  database_allocated_storage          = 100
  database_max_allocated_storage      = 1000
  database_multi_az                   = true
  database_backup_retention_days      = 30
  database_monitoring_interval        = 60
  database_name                       = "aira"
  database_migration_username         = "aira_migrator"
  cognito_domain_prefix               = var.cognito_domain_prefix
  cognito_mfa_configuration           = "ON"
  cognito_callback_urls               = ["https://${var.web_hostname}/auth/callback"]
  cognito_logout_urls                 = ["https://${var.web_hostname}/login"]
  allowed_eventbridge_source_accounts = var.allowed_eventbridge_source_accounts
  tags                                = var.tags
}
